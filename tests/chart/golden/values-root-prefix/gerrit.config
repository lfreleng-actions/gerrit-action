[gerrit]
	basePath = git
	canonicalWebUrl = https://review.example.org/
	serverId = 00000000-0000-4000-8000-000000000000
[httpd]
	listenUrl = proxy-https://*:8080/
[sshd]
	advertisedAddress = ssh.review.example.org:29418
	enableCompression = true
	idleTimeout = 1h
	listenAddress = *:29418
	threads = 16
[auth]
	type = DEVELOPMENT_BECOME_ANY_ACCOUNT
[sendemail]
	enable = false
[container]
	heapLimit = 3g
	javaOptions = "-Dflogger.backend_factory=com.google.common.flogger.backend.log4j.Log4jBackendFactory#getInstance"
	javaOptions = "-Dflogger.logging_context=com.google.gerrit.server.logging.LoggingContext#getInstance"
	javaOptions = -Djava.security.egd=file:/dev/./urandom
	javaOptions = --add-opens java.base/java.net=ALL-UNNAMED
	javaOptions = --add-opens java.base/java.lang.invoke=ALL-UNNAMED
	javaOptions = -XX:+UseG1GC
	user = gerrit
[cache]
	directory = cache
[cache "diff_summary"]
	diskLimit = 1g
[cache "gerrit_file_diff"]
	diskLimit = 1g
[cache "git_file_diff"]
	diskLimit = 1g
[cache "modified_files"]
	diskLimit = 1g
[change]
	allowBlame = true
	mergeabilityComputationBehavior = API_REF_UPDATED_AND_CHANGE_REINDEX
	updateDelay = 5min
[receive]
	enableSignedPush = false
	maxObjectSizeLimit = 100m
	timeout = 4min
[index]
	maxLimit = 10000
	onlineUpgrade = true
	type = lucene
[plugins]
	allowRemoteAdmin = false
