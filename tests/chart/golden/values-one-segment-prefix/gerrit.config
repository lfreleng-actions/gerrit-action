[gerrit]
	basePath = git
	canonicalWebUrl = https://gerrit.example.org/gerrit/
	instanceId = example-one
[httpd]
	listenUrl = proxy-https://*:8080/gerrit/
[sshd]
	advertisedAddress = gerrit.example.org:29418
	listenAddress = *:29418
[auth]
	cookieSecure = true
	editableAccountFields = FULL_NAME
	editableAccountFields = USER_NAME
	gitBasicAuthPolicy = HTTP
	type = HTTP
[sendemail]
	enable = true
	from = MIXED
	smtpEncryption = tls
	smtpServer = smtp.example.org
	smtpServerPort = 587
	smtpUser = gerrit@example.org
[container]
	javaOptions = "-Dflogger.backend_factory=com.google.common.flogger.backend.log4j.Log4jBackendFactory#getInstance"
	javaOptions = "-Dflogger.logging_context=com.google.gerrit.server.logging.LoggingContext#getInstance"
	javaOptions = -Djava.security.egd=file:/dev/./urandom
	javaOptions = --add-opens java.base/java.net=ALL-UNNAMED
	javaOptions = --add-opens java.base/java.lang.invoke=ALL-UNNAMED
	javaOptions = -XX:MaxRAMPercentage=70.0
	user = gerrit
[cache]
	directory = cache
[cache "diff_summary"]
	diskLimit = 1g
[cache "gerrit_file_diff"]
	diskLimit = 1g
[cache "git_file_diff"]
	diskLimit = 1g
[cache "modified_files"]
	diskLimit = 1g
[download]
	archive = tgz
	archive = zip
	command = checkout
	command = cherry_pick
	command = pull
	scheme = ssh
	scheme = anon_http
[plugins]
	allowRemoteAdmin = false
[trackingid "example"]
	link = https://issues.example.org/browse/$0
	match = EX-[0-9]+
	system = EXAMPLE
